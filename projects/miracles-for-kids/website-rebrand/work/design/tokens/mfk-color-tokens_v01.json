 "rules": {
  "max_brand_colors_per_screen": 3,
  "dominant_neutral": "canvas (white or cream) is always the largest area",
  "body_text": "text/primary (navy) on canvas or soft; on-* tokens on colored blocks",
  "highlight": "one highlight word per headline, color text/highlight; large sizes only. Contrast: highlight is display-size only (\u22653:1 for large text). On bg/primary use text/highlight-on-primary; on secondary/accent blocks use that block's on-* color.",
